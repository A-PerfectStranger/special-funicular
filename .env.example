# Synthetic local development ONLY. Copy to .env; never use these in AWS.
APP_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=synthetic-local-key-never-use-in-cloud-0000000000000000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=retiro
PGUSER=retiro_runtime
PGPASSWORD=synthetic-runtime-only
MIGRATION_DATABASE_URL=postgresql://retiro_migrator:synthetic-migrator-only@127.0.0.1:5432/retiro
GIT_SHA=local
# No business flows are implemented in E0. There is no enabling flag.
