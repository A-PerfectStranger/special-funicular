# Synthetic local development ONLY. Copy to .env; never use these in AWS.
APP_ENV=development
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=synthetic-local-key-never-use-in-cloud-0000000000000000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=retiro
PGUSER=retiro_runtime
PGPASSWORD=synthetic-runtime-only
MIGRATION_DATABASE_URL=postgresql://retiro_migrator:synthetic-migrator-only@127.0.0.1:5432/retiro
GIT_SHA=local
# E1 remains disabled until IdP, isolated SQL identities and archive are commissioned.
E1_IDENTITY_ENABLED=false
OIDC_ISSUER=
OIDC_WEB_CLIENT_ID=
OIDC_MOBILE_CLIENT_ID=
OIDC_WEB_REDIRECT_URI=
OIDC_MOBILE_REDIRECT_URI=retiro-seguro-dev://auth/callback
OIDC_MFA_POLICY=cognito_required_totp
OIDC_COGNITO_POOL_ID=
AWS_REGION=us-east-1
SYSTEM_READ_DATABASE_URL=postgresql://retiro_system_read:synthetic-system-read-only@127.0.0.1:5432/retiro
# Archive process only; do not inject this credential into API/web.
# ARCHIVE_DATABASE_URL=postgresql://retiro_archiver:synthetic-archiver-only@127.0.0.1:5432/retiro
# ARCHIVE_BUCKET=<synthetic-staging-bucket>
# ARCHIVE_KMS_KEY_ARN=<encryption-key-arn>
# MANIFEST_KMS_KEY_ARN=<signing-key-arn>
# ARCHIVE_RETENTION_DAYS=7

# E2 must pass its own acceptance before enabling in a deployed environment.
E2_FAMILY_ENABLED=false

# Synthetic-only E3 requires fully configured E1/E2; production stays blocked.
E3_PICKUP_ENABLED=false
