# Solo datos sinteticos. Copiar a .env; nunca usar en AWS.
APP_ENV=local
DJANGO_SECRET_KEY=synthetic-local-only-key-never-use-outside-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=retiro_synthetic
DB_USER=app_runtime
DB_PASSWORD=synthetic-runtime
DB_SSLMODE=disable
RELEASE_SHA=local
